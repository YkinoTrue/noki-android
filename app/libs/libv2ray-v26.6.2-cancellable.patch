+// CancelMeasureDelay cancels the controller's current delay measurement.
+func (x *CoreController) CancelMeasureDelay() {
+	x.measureMutex.Lock()
+	cancel := x.measureCancel
+	x.measureMutex.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+}
+
+func (x *CoreController) beginDelayMeasurement(timeout time.Duration) (context.Context, func()) {
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	done := make(chan struct{})
+
+	x.measureMutex.Lock()
+	x.measureGeneration++
+	generation := x.measureGeneration
+	previousCancel := x.measureCancel
+	x.measureCancel = cancel
+	x.measureDone = done
+	x.measureMutex.Unlock()
+
+	if previousCancel != nil {
+		previousCancel()
+	}
+
+	var once sync.Once
+	return ctx, func() {
+		once.Do(func() {
+			cancel()
+			close(done)
+			x.measureMutex.Lock()
+			if x.measureGeneration == generation {
+				x.measureCancel = nil
+				x.measureDone = nil
+			}
+			x.measureMutex.Unlock()
+		})
+	}
+}
+
+func (x *CoreController) cancelMeasureDelayAndWait() {
+	x.measureMutex.Lock()
+	cancel := x.measureCancel
+	done := x.measureDone
+	x.measureMutex.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+	if done != nil {
+		<-done
+	}
+}
