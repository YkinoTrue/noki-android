@@ -0,0 +1,49 @@
+package libv2ray
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestDelayMeasurementHonorsTimeout(t *testing.T) {
+	controller := &CoreController{}
+	ctx, finish := controller.beginDelayMeasurement(10 * time.Millisecond)
+	defer finish()
+
+	<-ctx.Done()
+
+	if !errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		t.Fatalf("expected deadline exceeded, got %v", ctx.Err())
+	}
+}
+
+func TestCancelMeasureDelayCancelsActiveMeasurement(t *testing.T) {
+	controller := &CoreController{}
+	ctx, finish := controller.beginDelayMeasurement(time.Second)
+	defer finish()
+
+	controller.CancelMeasureDelay()
+	<-ctx.Done()
+
+	if !errors.Is(ctx.Err(), context.Canceled) {
+		t.Fatalf("expected canceled, got %v", ctx.Err())
+	}
+}
+
+func TestOldCompletionDoesNotClearNewMeasurement(t *testing.T) {
+	controller := &CoreController{}
+	oldCtx, finishOld := controller.beginDelayMeasurement(time.Second)
+	newCtx, finishNew := controller.beginDelayMeasurement(time.Second)
+	defer finishNew()
+
+	<-oldCtx.Done()
+	finishOld()
+	controller.CancelMeasureDelay()
+	<-newCtx.Done()
+
+	if !errors.Is(newCtx.Err(), context.Canceled) {
+		t.Fatalf("expected new measurement to remain cancellable, got %v", newCtx.Err())
+	}
+}
